# Air Quality API (OpenAQ)
OPENAQ_API_KEY="your_openaq_api_key_here"

# Weather API (Open-Meteo does not require a key for demo use)
# WEATHER_API_KEY=""

# Map Tiles (Optional: if using Mapbox instead of open CartoDB tiles)
MAPBOX_API_KEY="your_mapbox_api_key_here"

# Environment Mode
APP_ENV="demo" # Set to 'live' to fetch real API data
